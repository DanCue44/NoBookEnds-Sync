# CPU-only image (ghcr.io/dancue44/nobookends-sync:cpu): no CUDA libraries,
# faster-whisper on CPU with int8. Slower than a GPU (see README) but runs on
# any x86-64 server. Overnight mode (AUTO_WINDOW) keeps the CPU load to the
# hours you choose.
#
# Builds with the classic builder too: no BuildKit-only syntax in here.
ARG BASE_IMAGE=python:3.12-slim-bookworm

# ---------------------------------------------------------------- build
FROM ${BASE_IMAGE} AS build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
COPY requirements.txt /tmp/requirements.txt
RUN /opt/venv/bin/pip install -r /tmp/requirements.txt \
 && /opt/venv/bin/pip uninstall -y pip \
 && find /opt/venv -type d -name __pycache__ -prune -exec rm -rf {} + \
 && rm -rf /opt/venv/lib/python3*/site-packages/numpy/_core/tests \
           /opt/venv/lib/python3*/site-packages/numpy/*/tests \
           /opt/venv/lib/python3*/site-packages/onnxruntime/tools \
           /opt/venv/lib/python3*/site-packages/onnxruntime/transformers \
           /opt/venv/lib/python3*/site-packages/onnxruntime/quantization

# ---------------------------------------------------------------- runtime
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app \
    DATA_DIR=/data \
    HF_HOME=/data/models/hf \
    WHISPER_DEVICE=cpu \
    WHISPER_CPU_COMPUTE_TYPE=int8 \
    WHISPER_CPU_THREADS=auto

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY nobookends_sync ./nobookends_sync

LABEL org.opencontainers.image.title="NoBookEnds Sync (CPU)" \
      org.opencontainers.image.description="Aligns audiobook narration to EPUB text for NoBookEnds Listen & Read (CPU only)" \
      org.opencontainers.image.source="https://github.com/DanCue44/NoBookEnds-Sync"

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
  CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=5).status == 200 else 1)"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "nobookends_sync"]
